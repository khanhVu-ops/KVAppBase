    "The server returned invalid data. Please try again later.": {
      "comment": "AppError.decoding — a backend contract change; never actionable by the user.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد الخادم بيانات غير صالحة. حاول لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat ungültige Daten zurückgegeben. Bitte versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server returned invalid data. Please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor devolvió datos no válidos. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a renvoyé des données invalides. Veuillez réessayer plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर से अमान्य डेटा मिला। कृपया बाद में कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server mengirim data yang tidak valid. Silakan coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha restituito dati non validi. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーから無効なデータが返されました。しばらくしてからお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 잘못된 데이터를 반환했습니다. 나중에 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server heeft ongeldige gegevens teruggestuurd. Probeer het later opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor retornou dados inválidos. Tente novamente mais tarde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor devolveu dados inválidos. Tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер вернул неверные данные. Попробуйте позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ส่งข้อมูลที่ไม่ถูกต้อง โปรดลองอีกครั้งในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu geçersiz veri döndürdü. Lütfen daha sonra tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu trả về không hợp lệ. Vui lòng thử lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器返回的数据无效，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器傳回的資料無效，請稍後重試。"
          }
        }
      }
    },
