    "Password must be at least 6 characters.": {
      "comment": "SignInUseCase validation. The 6 is a fixed business rule, so no plural variant is needed.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تتكون كلمة المرور من 6 أحرف على الأقل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort muss mindestens 6 Zeichen lang sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password must be at least 6 characters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña debe tener al menos 6 caracteres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe doit contenir au moins 6 caractères."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासवर्ड में कम से कम 6 अक्षर होने चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata sandi harus minimal 6 karakter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La password deve contenere almeno 6 caratteri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードは6文字以上で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호는 6자 이상이어야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wachtwoord moet minstens 6 tekens bevatten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A senha deve ter pelo menos 6 caracteres."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A palavra-passe deve ter pelo menos 6 caracteres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль должен содержать не менее 6 символов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสผ่านต้องมีอย่างน้อย 6 ตัวอักษร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifre en az 6 karakter olmalıdır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mật khẩu phải có ít nhất 6 ký tự."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码至少需要 6 个字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密碼至少需要 6 個字元。"
          }
        }
      }
    },
