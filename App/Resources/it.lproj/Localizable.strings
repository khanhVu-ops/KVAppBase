"Search by order code" = "Cerca per codice ordine";

/* Order status badge — on its way. */
"Shipping" = "In consegna";

/* Sign-in screen title and the submit button. */
"Sign in" = "Accedi";

/* AppError.unknown — deliberately generic; the technical detail goes to the log via `diagnostic`. */
"Something went wrong. Please try again." = "Si è verificato un errore. Riprova.";

/* First row of the language picker: follow the device setting. */
"System language" = "Lingua di sistema";

/* AppError.decoding — a backend contract change; never actionable by the user. */
