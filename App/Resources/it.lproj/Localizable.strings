"Order history" = "Cronologia ordini";

/* Order list screen title. */
"Orders" = "Ordini";

/* Password field placeholder. */
"Password" = "Password";

/* SignInUseCase validation. The 6 is a fixed business rule, so no plural variant is needed. */
"Password must be at least 6 characters." = "La password deve contenere almeno 6 caratteri.";

/* Order status badge. */
"Pending" = "In attesa";

/* SignInUseCase validation — empty email field. */
"Please enter your email." = "Inserisci il tuo indirizzo email.";

