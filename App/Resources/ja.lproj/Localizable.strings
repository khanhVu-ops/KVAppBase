"Something went wrong. Please try again." = "エラーが発生しました。もう一度お試しください。";

/* First row of the language picker: follow the device setting. */
"System language" = "システムの言語";

/* AppError.decoding — a backend contract change; never actionable by the user. */
"The server returned invalid data. Please try again later." = "サーバーから無効なデータが返されました。しばらくしてからお試しください。";

/* Row label on the order detail screen — the order total. */
"Total" = "合計";

/* Forgot-password screen. %@ is the email the user typed. */
"We will send instructions to %@." = "%@ に手順をお送りします。";

/* Empty state body on the order list. */
"Your orders will appear here." = "注文はここに表示されます。";

/* AppError.unauthorized — SessionController handles the sign-out; no screen shows its own message. */
"Your session has expired." = "セッションの有効期限が切れました。";
