"Replace this with your real screen." = "ここを実際の画面に置き換えてください。";

/* Button on the error state view. Worked example: every language this app declares is filled in here, and tools/check-l10n.sh fails if any is missing. */
"Retry" = "再試行";

/* Search field prompt on the order list. */
"Search by order code" = "注文番号で検索";

/* Order status badge — on its way. */
"Shipping" = "配送中";

/* Sign-in screen title and the submit button. */
"Sign in" = "ログイン";

