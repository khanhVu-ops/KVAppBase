/* Localizable.strings

   Mọi key phải có mặt ở CẢ 19 file, với giá trị đã dịch —
   tools/check-l10n.sh fail nếu thiếu một key hoặc một ngôn ngữ. */

/* Dismiss button on alerts and sheets. */
"Close" = "ปิด";

/* Default alert title for AlertState(error:). One word — check it is not truncated in the alert. */
"Error" = "ข้อผิดพลาด";

/* SignInUseCase validation — email fails the format check. */
"Invalid email address." = "อีเมลไม่ถูกต้อง";

/* Title of the in-app language picker, and the toolbar button that opens it. */
"Language" = "ภาษา";

/* AppError.offline — shown on the error state view and in alerts. */
"No internet connection. Please try again." = "ไม่มีการเชื่อมต่ออินเทอร์เน็ต โปรดลองอีกครั้ง";

/* SignInUseCase validation. The 6 is a fixed business rule, so no plural variant is needed. */
"Password must be at least 6 characters." = "รหัสผ่านต้องมีอย่างน้อย 6 ตัวอักษร";

/* SignInUseCase validation — empty email field. */
"Please enter your email." = "โปรดกรอกอีเมล";

/* Button on the error state view. Worked example: every language this app declares is filled in here, and tools/check-l10n.sh fails if any is missing. */
"Retry" = "ลองอีกครั้ง";

/* AppError.unknown — deliberately generic; the technical detail goes to the log via `diagnostic`. */
"Something went wrong. Please try again." = "เกิดข้อผิดพลาด โปรดลองอีกครั้ง";

/* First row of the language picker: follow the device setting. */
"System language" = "ภาษาของระบบ";

/* AppError.decoding — a backend contract change; never actionable by the user. */
"The server returned invalid data. Please try again later." = "เซิร์ฟเวอร์ส่งข้อมูลที่ไม่ถูกต้อง โปรดลองอีกครั้งในภายหลัง";

/* AppError.unauthorized — SessionController handles the sign-out; no screen shows its own message. */
"Your session has expired." = "เซสชันของคุณหมดอายุแล้ว";
